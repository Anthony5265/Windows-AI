{  "$schema": "https://json-schema.org/draft/2020-12/schema",  "title": "Actions API Response",  "type": "object",  "required": ["ok", "request_id"],  "oneOf": [    {      "properties": {        "ok": { "const": true },        "result": { "type": "object" },        "request_id": { "type": "string" }      },      "required": ["result"]    },    {      "properties": {        "ok": { "const": false },        "error": {          "type": "object",          "required": ["code", "message"],          "properties": {            "code": { "type": "string" },            "message": { "type": "string" },            "hint": { "type": "string" }          }        },        "request_id": { "type": "string" }      },      "required": ["error"]    }  ]}