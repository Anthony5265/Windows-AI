{
  "name": "windows-ai-tray",
  "version": "0.1.0",
  "private": true,
  "description": "Windows AI System Tray Application with Quick Commands",
  "main": "main.js",
  "author": "Windows AI",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win --x64 portable"
  },
  "build": {
    "appId": "com.windowsai.tray",
    "productName": "Windows AI Tray",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/*",
      "!userdata/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Windows AI Tray",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "WindowsAI-Tray-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "node-fetch": "^2.6.1"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  }
}
