{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terminal Workflow",
  "type": "object",
  "required": ["id", "title", "run"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["string","number","path","boolean"] },
          "default": {}
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["shell","script","action"] },
        "action": { "type": "object" },
        "script": { "type": "string" }
      }
    }
  }
}
