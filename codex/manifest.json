{
    "entry": "specs/WindowsAI_MasterSpec_latest.md",
    "fallbacks": [
        "specs/WindowsAI_MasterSpec_v0.0.md",
        "specs/WindowsAI_MasterSpec_v0.10.md",
        "specs/WindowsAI_MasterSpec_v0.2.md",
        "specs/WindowsAI_MasterSpec_v0.3.md",
        "specs/WindowsAI_MasterSpec_v0.4.md",
        "specs/WindowsAI_MasterSpec_v0.5.md",
        "specs/WindowsAI_MasterSpec_v0.6.md",
        "specs/WindowsAI_MasterSpec_v0.7.md",
        "specs/WindowsAI_MasterSpec_v0.8.md",
        "specs/WindowsAI_MasterSpec_v0.9.md"
    ],
    "endpoints": {
        "actions": "/api/actions/execute",
        "agenthub_workflows": "/workflows/run",
        "proxy": "/v1/chat/completions"
    },
    "folders": {
        "tasks": "codex/TASKS/",
        "state": "codex/STATE.json",
        "history": "codex/HISTORY/",
        "openapi": "openapi/",
        "schemas": "codex/SCHEMAS/",
        "root_files": "codex/ROOT_FILES/",
        "workflows": "codex/GITHUB_WORKFLOWS/"
    },
    "policies": {
        "commit_style": "conventional_commits",
        "docs_public": "docs/",
        "ci_required": true
    },
    "tasks": {
        "update-prs": {
            "description": "Rebase all open PR branches onto main and push updates",
            "script": "codex/SCRIPTS/update_prs.ps1"
        },
        "pr-merge-check": {
            "description": "Check PRs for merge conflicts with main",
            "workflow": "pr-merge-conflict.yml"
        },
        "merge-prs": {
            "description": "Merge main into open PR branches and push updates",
            "script": "codex/SCRIPTS/merge_prs.ps1"
        }
    }
}