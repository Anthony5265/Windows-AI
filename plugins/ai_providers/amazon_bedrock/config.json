{
  "name": "Amazon Bedrock",
  "version": "1.0.0",
  "api_base": "https://bedrock-runtime.us-east-1.amazonaws.com",
  "requires_key": true,
  "models": [
    "anthropic.claude-v2",
    "amazon.titan-text",
    "ai21.j2-ultra"
  ],
  "capabilities": [
    "text-generation",
    "chat"
  ],
  "settings": {
    "default_model": "anthropic.claude-v2",
    "timeout": 60,
    "max_retries": 3
  }
}