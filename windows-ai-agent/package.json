{
  "name": "windows-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Windows AI agent with CLI and plugins (shell, files, openai, github)",
  "bin": {
    "wai": "bin/wai.js"
  },
  "scripts": {
