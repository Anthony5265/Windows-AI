[run]
# Specify the source code directories
source =
    windows_ai
    apps/gui

# Omit test files and migrations
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */node_modules/*
    */venv/*
    */.venv/*
    */migrations/*
    */conftest.py
    */setup.py

# Enable branch coverage
branch = True

# Run tests in parallel
parallel = True

[report]
# Fail if coverage is below this threshold
fail_under = 80

# Show missing lines
show_missing = True

# Precision for coverage percentage
precision = 2

# Exclude lines from coverage
exclude_lines =
    # Standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    def __str__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if TYPE_CHECKING:

    # Don't complain about abstract methods
    @abstractmethod
    @abc.abstractmethod

    # Don't complain about overload signatures
    @overload

[html]
# Directory for HTML coverage report
directory = htmlcov

[xml]
# Output file for XML coverage report
output = coverage.xml
