{
  "name": "HuggingFace",
  "version": "1.0.0",
  "api_base": "https://api-inference.huggingface.co",
  "requires_key": true,
  "models": [
    "gpt2",
    "facebook/opt-350m",
    "bigscience/bloom-560m"
  ],
  "capabilities": [
    "text-generation",
    "chat"
  ],
  "settings": {
    "default_model": "gpt2",
    "timeout": 60,
    "max_retries": 3
  }
}